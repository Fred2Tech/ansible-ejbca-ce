# ------------- Database configuration ------------------------
#{{ ansible_managed | comment }}

database.useSeparateCertificateTable={{ ejbca_db_database_useSeparateCertificateTable }}
{% if appsrv_datasources[0] is defined %}{% for item in appsrv_datasources %}
{% if item.database_connection_type in ['mariadb', 'postgresql'] %}
database.url=jdbc:{{ item.database_connection_type| default('mariadb') }}://{{ item.host }}:{{ item.port }}/{{ item.database }}
{% elif item.database_connection_type == "sqlserver" %}
database.url=jdbc:{{ item.database_connection_type| default('mariadb') }}://{{ item.host }}:{{ item.port }};DatabaseName={{ item.database }}{{ item.connection_parameters }}
{% else %}
database.url=jdbc:{{ item.database_connection_type| default('mariadb') }}://{{ item.host }}:{{ item.port }}
{% endif %}
database.driver={{ item.database_driver_class| default('org.mariadb.jdbc.Driver') }}
database.username={{ item.user }}
database.password={{ item.password }}
database.name={% if item.database_connection_type == 'mariadb' %}mysql{% elif item.database_connection_type == 'sqlserver' %}mssql{% elif item.database_connection_type == 'postgresql' %}postgres{% else %}{{ item.database_connection_type }}{% endif %}
{% endfor %}{% endif %}
